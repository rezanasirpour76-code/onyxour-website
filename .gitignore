# Server-script and file backups (don't belong in this repo)
*.bak_*
*.backup*.html

# Prerender working artifacts (regenerated by `npm run build`)
prerender/node_modules/
prerender/dist/
prerender/.last-*

# Graphify knowledge-graph artifacts (regenerated by `graphify .`)
graphify-out/

# Local tooling state (impeccable live-preview server, etc.)
.impeccable/
